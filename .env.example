# ============================================================
# Переменные окружения, которые ДОЛЖНЫ быть заданы у сервисов.
# В сам config-репозиторий секреты не коммитятся: здесь только
# плейсхолдеры ${...}, а значения подставляет окружение сервиса.
# ============================================================

# --- Redis (общий для всех сервисов) ---
REDIS_HOST=localhost
REDIS_PASSWORD=

# --- Keycloak ---
KEYCLOAK_ISSUER_URI=http://localhost:8090/realms/merchly
KEYCLOAK_SERVER_URL=http://localhost:8090
KEYCLOAK_TOKEN_URI=http://localhost:8090/realms/merchly/protocol/openid-connect/token
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=

# client secrets из realm merchly
FRONTEND_SERVICE_CLIENT_SECRET=
ORDERS_SERVICE_CLIENT_SECRET=

# --- Базы данных (по одной на сервис) ---
USERS_DB_HOST=localhost
USERS_DB_PORT=5432
USERS_DB_NAME=merchly_users
USERS_DB_USER=
USERS_DB_PASSWORD=

PRODUCTS_DB_HOST=localhost
PRODUCTS_DB_PORT=5433
PRODUCTS_DB_NAME=merchly_products
PRODUCTS_DB_USER=
PRODUCTS_DB_PASSWORD=

REVIEWS_DB_HOST=localhost
REVIEWS_DB_PORT=5435
REVIEWS_DB_NAME=merchly_reviews
REVIEWS_DB_USER=
REVIEWS_DB_PASSWORD=

ORDERS_DB_HOST=localhost
ORDERS_DB_PORT=5436
ORDERS_DB_NAME=merchly_orders
ORDERS_DB_USER=
ORDERS_DB_PASSWORD=

# --- MinIO ---
# MINIO_URL       — адрес, по которому ходят СЕРВИСЫ (внутренняя сеть)
# MINIO_PUBLIC_URL — адрес, по которому картинки грузит БРАУЗЕР
MINIO_URL=http://localhost:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Адреса сервисов (переопределяют дефолты профиля) ---
PRODUCT_SERVICE_URI=
USERS_SERVICE_URI=
REVIEWS_SERVICE_URI=
ORDERS_SERVICE_URI=
